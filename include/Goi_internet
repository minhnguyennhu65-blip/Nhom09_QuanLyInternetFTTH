#ifndef UC01_GOI_INTERNET_HPP
#define UC01_GOI_INTERNET_HPP

#include <string>
#include <vector>
#include <iostream>
#include <iomanip>
#include <fstream>
#include <sstream>

class GoiInternet {
private:
    std::string maGoi;
    std::string tenGoi;
    double tocDo;      // Mbps
    double giaThang;   // VNĐ
    std::string moTa;
    bool trangThai;    // true: Hoat dong, false: Ngung

public:
    GoiInternet() : tocDo(0), giaThang(0), trangThai(true) {}
    
    GoiInternet(std::string ma, std::string ten, double td, double gia, std::string mt, bool tt)
        : maGoi(ma), tenGoi(ten), tocDo(td), giaThang(gia), moTa(mt), trangThai(tt) {}

    std::string getMaGoi() const { return maGoi; }
    std::string getTenGoi() const { return tenGoi; }
    double getTocDo() const { return tocDo; }
    double getGiaThang() const { return giaThang; }
    std::string getMoTa() const { return moTa; }
    bool getTrangThai() const { return trangThai; }

    void setTenGoi(const std::string& ten) { tenGoi = ten; }
    void setTocDo(double td) { tocDo = td; }
    void setGiaThang(double gia) { giaThang = gia; }
    void setMoTa(const std::string& mt) { moTa = mt; }
    void setTrangThai(bool tt) { trangThai = tt; }

    void hienThi() const {
        std::cout << std::left 
                  << std::setw(12) << maGoi 
                  << std::setw(20) << tenGoi 
                  << std::setw(12) << (std::to_string((int)tocDo) + " Mbps")
                  << std::setw(15) << (std::to_string((long long)giaThang) + " VND")
                  << std::setw(18) << (trangThai ? "Hoat dong" : "Ngung hoat dong")
                  << moTa << std::endl;
    }
};

class UC01_GoiInternetService {
private:
    std::vector<GoiInternet> danhSachGoi;

public:
    int timKiemIndex(const std::string& maGoi) const {
        for (size_t i = 0; i < danhSachGoi.size(); ++i) {
            if (danhSachGoi[i].getMaGoi() == maGoi) return i;
        }
        return -1;
    }

    bool themGoi(const GoiInternet& goi) {
        if (timKiemIndex(goi.getMaGoi()) != -1) return false;
        danhSachGoi.push_back(goi);
        return true;
    }

    bool capNhatGoi(const std::string& maGoi, const GoiInternet& goiMoi) {
        int idx = timKiemIndex(maGoi);
        if (idx == -1) return false;
        danhSachGoi[idx] = goiMoi;
        return true;
    }

    bool xoaGoi(const std::string& maGoi) {
        int idx = timKiemIndex(maGoi);
        if (idx == -1) return false;
        danhSachGoi.erase(danhSachGoi.begin() + idx);
        return true;
    }

    void hienThiDanhSach() const {
        std::cout << "\n=================== UC01: DANH SACH GOI INTERNET ===================\n";
        std::cout << std::left 
                  << std::setw(12) << "Ma Goi" 
                  << std::setw(20) << "Ten Goi" 
                  << std::setw(12) << "Toc Do" 
                  << std::setw(15) << "Gia Thang" 
                  << std::setw(18) << "Trang Thai" 
                  << "Mo Ta" << std::endl;
        std::cout << std::string(85, '-') << std::endl;
        for (const auto& goi : danhSachGoi) {
            goi.hienThi();
        }
        std::cout << std::string(85, '-') << std::endl;
    }

    bool docTuFile(const std::string& filePath) {
        std::ifstream file(filePath);
        if (!file.is_open()) return false;

        danhSachGoi.clear();
        std::string line;
        while (std::getline(file, line)) {
            if (line.empty()) continue;
            std::stringstream ss(line);
            std::string ma, ten, tocDoStr, giaStr, moTa, statusStr;

            std::getline(ss, ma, '|');
            std::getline(ss, ten, '|');
            std::getline(ss, tocDoStr, '|');
            std::getline(ss, giaStr, '|');
            std::getline(ss, moTa, '|');
            std::getline(ss, statusStr, '|');

            if (!ma.empty()) {
                double tocDo = std::stod(tocDoStr);
                double gia = std::stod(giaStr);
                bool status = (statusStr == "1");
                danhSachGoi.push_back(GoiInternet(ma, ten, tocDo, gia, moTa, status));
            }
        }
        file.close();
        return true;
    }

    bool ghiRaFile(const std::string& filePath) const {
        std::ofstream file(filePath);
        if (!file.is_open()) return false;

        for (const auto& goi : danhSachGoi) {
            file << goi.getMaGoi() << "|"
                 << goi.getTenGoi() << "|"
                 << goi.getTocDo() << "|"
                 << (long long)goi.getGiaThang() << "|"
                 << goi.getMoTa() << "|"
                 << (goi.getTrangThai() ? "1" : "0") << "\n";
        }
        file.close();
        return true;
    }
};

#endif
