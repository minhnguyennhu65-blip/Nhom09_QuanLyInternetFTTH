#ifndef UC02_TUYEN_CAP_HPP
#define UC02_TUYEN_CAP_HPP

#include <string>
#include <vector>

class TuyenCap {
private:
    std::string maTuyen;
    std::string tenTuyen;
    std::string khuVuc;
    std::string diaDiemDau;
    std::string diaDiemCuoi;
    bool trangThai; // true: Ho?t d?ng, false: B?o trì

public:
    TuyenCap();
    TuyenCap(std::string ma, std::string ten, std::string kv, std::string dau, std::string cuoi, bool tt);

    std::string getMaTuyen() const;
    std::string getTenTuyen() const;
    std::string getKhuVuc() const;
    std::string getDiaDiemDau() const;
    std::string getDiaDiemCuoi() const;
    bool getTrangThai() const;

    void setTenTuyen(const std::string& ten);
    void setKhuVuc(const std::string& kv);
    void setDiaDiemDau(const std::string& dau);
    void setDiaDiemCuoi(const std::string& cuoi);
    void setTrangThai(bool tt);

    void hienThi() const;
};

class UC02_TuyenCapService {
private:
    std::vector<TuyenCap> danhSachTuyen;

public:
    int timKiemIndex(const std::string& maTuyen) const;
    bool themTuyen(const TuyenCap& tuyen);
    bool capNhatTuyen(const std::string& maTuyen, const TuyenCap& tuyenMoi);
    bool xoaTuyen(const std::string& maTuyen);
    void hienThiDanhSach() const;

    bool docTuFile(const std::string& filePath);
    bool ghiRaFile(const std::string& filePath) const;
};

#endif
